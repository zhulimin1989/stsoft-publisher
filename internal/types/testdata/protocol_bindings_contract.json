    "function_tools",
    "json_mode",
    "json_schema",
    "mcp_tools",
    "reasoning",
    "reasoning_split",
    "responses_stateful",
    "server_side_tools",
    "streaming_tools",
    "streaming_usage",
    "vision",
    "web_search"
  ],
  "capability_params": [
    "frequency_penalty",
    "logprobs",
    "max_tokens",
    "n",
    "parallel_tool_calls",
    "presence_penalty",
    "reasoning_effort",
    "reasoning_split",
    "response_format",
    "seed",
    "stop",
    "stream",
    "stream_options",
