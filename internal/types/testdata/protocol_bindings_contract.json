      "path_template": "/models/{upstream_model}:embedContent"
    },
    {
      "outbound_protocol": "glm",
      "capability": "chat",
      "request_contract": "chat_completions",
      "path_template": "/chat/completions"
    },
    {
      "outbound_protocol": "glm",
      "capability": "embeddings",
      "request_contract": "embeddings",
      "path_template": "/embeddings"
    },
    {
      "outbound_protocol": "glm_coding",
      "capability": "chat",
      "request_contract": "chat_completions",
      "path_template": "/chat/completions"
    },
    {
      "outbound_protocol": "openai",
      "capability": "chat",
      "request_contract": "anthropic_messages",
      "path_template": "/chat/completions"
    },
    {
      "outbound_protocol": "openai",
      "capability": "chat",
      "request_contract": "chat_completions",
      "path_template": "/chat/completions"
    },
    {
      "outbound_protocol": "openai",
      "capability": "chat",
      "request_contract": "responses",
      "path_template": "/chat/completions"
    },
    {
      "outbound_protocol": "openai",
      "capability": "embeddings",
      "request_contract": "embeddings",
      "path_template": "/embeddings"
    },
    {
      "outbound_protocol": "openai",
