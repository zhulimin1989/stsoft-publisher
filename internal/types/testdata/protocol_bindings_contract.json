{
  "version": 2,
  "source": "tokenplatform-gateway/internal/bindingspec+capabilityspec+capabilityprofile",
  "provider_profiles": [
    "anthropic_native",
    "azure_openai",
    "cohere_v2",
    "doubao_ark",
    "gemini_native",
    "glm",
    "glm_coding",
    "openai_compatible",
    "openai_native",
    "openai_responses_native"
  ],
  "client_compatibilities": [
    "all",
    "cherrystudio",
    "claude_code",
    "cline",
    "codex",
    "cursor",
    "dify",
    "gemini_cli",
    "openai_sdk",
    "openclaw"
  ],
  "token_count_strategies": [
    "gateway_estimate",
    "native",
    "unsupported"
  ],
  "inbound_protocols": [
    "anthropic",
    "ark",
    "gemini",
    "glm",
    "glm_coding",
    "openai",
    "responses"
  ],
  "capabilities": [
    "chat",
    "count_tokens",
    "embeddings",
    "image_generation",
    "rerank",
    "video_generation"
  ],
  "request_contracts": [
    "anthropic_count_tokens",
    "anthropic_messages",
    "ark_video_task_create",
    "chat_completions",
    "embeddings",
    "gemini_generate",
    "image_generations",
    "rerank",
    "responses"
  ],
  "outbound_protocols": [
    "anthropic",
    "ark",
    "azure_openai",
    "cohere_v2",
    "doubao_ark",
    "gemini",
    "glm",
    "glm_coding",
    "openai",
    "openai_responses"
  ],
  "auth_schemes": [
    "azure-key",
    "bearer",
    "google-key",
    "jwt-or-bearer",
    "x-api-key"
  ],
  "translators": [
    "passthrough",
    "responses_to_chat_synthesis",
    "standard_to_anthropic",
    "standard_to_gemini",
    "standard_to_openai",
    "standard_to_openai_responses"
  ],
  "bridges": [
    "anthropic_to_openai_chat",
    "responses_to_chat"
  ],
  "dedicated_protocol_channels": [
    "passthrough",
    "responses_to_chat",
    "anthropic_to_chat"
  ],
  "lossy_tiers": [
    "low",
    "high"
  ],
  "bridge_contracts": [
    {
      "bridge": "anthropic_to_openai_chat",
      "lossy_tier": "high"
    },
    {
      "bridge": "responses_to_chat",
      "lossy_tier": "low",
      "admitted_subset": {
        "request": {
          "allowed_item_types": [
            "function_call",
            "function_call_output",
            "input_text",
            "message"
          ]
        },
        "response": {
          "allowed_output_types": [
            "function_call",
            "message"
          ]
        },
        "streaming": {
          "allowed_events": [
            "completed",
            "final_usage",
            "function_call_arguments.delta",
            "function_call_arguments.done",
            "response.output_item.added",
            "response.output_text.delta"
          ]
        }
      }
    }
  ],
  "compat_api_types": [
    "anthropic",
    "ark",
    "azure",
    "cohere_v2",
    "doubao",
    "gemini",
    "glm",
    "glm_coding",
    "openai",
    "openai_responses",
    "zhipu"
  ],
  "capability_profiles": [
    "anthropic.messages.base",
    "anthropic.messages.tools",
    "gemini.generate_content.base",
    "gemini.generate_content.tools",
    "minimax.openai_chat.m2_m25_no_tools",
    "minimax.openai_chat.m3_m27",
    "minimax.openai_chat.response_extensions",
    "minimax.openai_chat.thinking",
    "openai.chat_completions.base",
