    "enum"
  ],
  "param_policy_actions": [
    "preserve",
    "omit",
    "omit_with_warning",
    "normalize",
    "normalize_with_warning",
    "reject"
  ],
  "field_disposition_actions": [
    "preserve",
    "adapt",
    "drop",
    "reject",
    "preserve_vendor_extra",
    "passthrough_raw"
  ],
  "request_correlation_modes": [
    "none",
    "gateway_header",
    "user_agent",
    "gateway_header_and_user_agent"
  ],
  "runtime_endpoints": [
