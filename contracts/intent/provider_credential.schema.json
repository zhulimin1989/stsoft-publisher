{
  "$id": "https://tokenplatform.local/contracts/intent/provider_credential.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "alias": {
      "type": "string"
    },
    "allowed_models": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "key_id": {
      "type": "string"
    },
    "key_ref": {
      "type": "string"
    },
    "priority": {
      "type": "integer"
    },
    "provider_account_ref": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "provider_id": {
      "type": "string"
    },
    "rpm_limit": {
      "type": "integer"
    },
    "status": {
      "type": "string"
    },
    "tpm_limit": {
      "type": "integer"
    },
    "weight": {
      "type": "integer"
    }
  },
  "required": [
    "provider_id",
    "key_ref",
    "provider_account_ref",
    "status"
  ],
  "title": "ProviderCredential",
  "type": "object",
  "version": 2
}
