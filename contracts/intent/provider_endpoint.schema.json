{
  "$id": "https://tokenplatform.local/contracts/intent/provider_endpoint.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "visibility": {
            "const": "dedicated_only"
          }
        },
        "required": [
          "visibility"
        ],
        "type": "object"
      },
      "then": {
        "properties": {
          "allowed_route_kinds": {
            "items": {
              "const": "dedicated_route"
            },
            "maxItems": 1,
            "minItems": 1,
            "type": "array"
          },
          "credential_source": {
            "enum": [
              "dedicated_upstream",
              "provider_entitlement"
            ]
          },
          "owner_scope": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "additionalProperties": false,
            "properties": {
              "entitlement_id": {
                "type": "string"
              },
              "product_id": {
                "type": "string"
              },
              "tenant_id": {
                "type": "string"
              }
            },
            "title": "OwnerScope",
            "type": "object",
            "version": 1
          },
          "visibility": {
            "const": "dedicated_only"
          }
        },
        "required": [
          "visibility",
          "credential_source",
          "allowed_route_kinds"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "allowed_route_kinds": {
            "items": {
              "const": "dedicated_route"
            },
            "maxItems": 1,
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "allowed_route_kinds"
        ],
        "type": "object"
      },
      "then": {
        "properties": {
          "allowed_route_kinds": {
            "items": {
              "const": "dedicated_route"
            },
            "maxItems": 1,
            "minItems": 1,
            "type": "array"
          },
          "credential_source": {
            "enum": [
              "dedicated_upstream",
              "provider_entitlement"
            ]
          },
          "owner_scope": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "additionalProperties": false,
            "properties": {
              "entitlement_id": {
                "type": "string"
              },
              "product_id": {
                "type": "string"
              },
              "tenant_id": {
                "type": "string"
              }
            },
            "title": "OwnerScope",
            "type": "object",
            "version": 1
          },
          "visibility": {
            "const": "dedicated_only"
          }
        },
        "required": [
          "visibility",
          "credential_source",
          "allowed_route_kinds"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "credential_source": {
            "enum": [
              "dedicated_upstream",
              "provider_entitlement"
            ]
          }
        },
        "required": [
          "credential_source"
        ],
        "type": "object"
      },
      "then": {
        "properties": {
          "allowed_route_kinds": {
            "items": {
              "const": "dedicated_route"
            },
            "maxItems": 1,
            "minItems": 1,
            "type": "array"
          },
          "credential_source": {
            "enum": [
              "dedicated_upstream",
              "provider_entitlement"
            ]
          },
          "owner_scope": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "additionalProperties": false,
            "properties": {
              "entitlement_id": {
                "type": "string"
              },
              "product_id": {
                "type": "string"
              },
              "tenant_id": {
                "type": "string"
              }
            },
            "title": "OwnerScope",
            "type": "object",
            "version": 1
          },
          "visibility": {
            "const": "dedicated_only"
          }
        },
        "required": [
          "visibility",
          "credential_source",
          "allowed_route_kinds"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "credential_source": {
            "const": "provider_entitlement"
          }
        },
        "required": [
          "credential_source"
        ],
        "type": "object"
      },
      "then": {
        "required": [
          "provider_account_ref"
        ]
      }
    }
  ],
  "properties": {
    "allowed_route_kinds": {
      "default": [
        "model_route",
        "product_route"
      ],
      "items": {
        "enum": [
          "dedicated_route",
          "model_route",
          "product_route"
        ],
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "base_url": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "credential_source": {
      "default": "keypool",
      "enum": [
        "keypool",
        "dedicated_upstream",
        "provider_entitlement"
      ],
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "key_strategy": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "owned_by": {
      "type": "string"
    },
    "owner_scope": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "entitlement_id": {
          "type": "string"
        },
        "product_id": {
          "type": "string"
        },
        "tenant_id": {
          "type": "string"
        }
      },
      "title": "OwnerScope",
      "type": "object",
      "version": 1
    },
    "path_prefix": {
      "type": "string"
    },
    "provider_account_ref": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "provider_profile": {
      "enum": [
        "anthropic_native",
        "azure_openai",
        "cohere_v2",
        "doubao_ark",
        "gemini_native",
        "glm",
        "glm_coding",
        "openai_compatible",
        "openai_native",
        "openai_responses_native"
      ],
      "type": "string"
    },
    "region": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "visibility": {
      "default": "product_route",
      "enum": [
        "product_route",
        "dedicated_only",
        "internal"
      ],
      "type": "string"
    }
  },
  "required": [
    "id",
    "provider_profile",
    "base_url",
    "status"
  ],
  "title": "ProviderEndpoint",
  "type": "object",
  "version": 2
}
