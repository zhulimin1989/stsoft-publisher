        "required": [
          "priority",
          "provider_id",
          "status",
          "upstream_model",
          "weight"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "revision": {
      "type": "integer"
    },
    "schema_version": {
      "type": "integer"
    }
