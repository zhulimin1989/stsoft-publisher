          "type": "object"
        },
        "compliance_tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "preferred_providers": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "required_capabilities": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "required_params": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "fallback_model": {
      "type": "string"
    },
    "model_id": {
      "type": "string"
    },
    "provider_strategy": {
      "type": "string"
    },
    "providers": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "anthropic_beta": {
            "type": "string"
          },
          "api_version": {
            "type": "string"
          },
          "capabilities": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
